# OpenRouter works with an account that holds paid credits while calling a $0 free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Throttled to <= ~17 LLM calls/minute on a single instance
LLM_MIN_INTERVAL_MS=3500
# Optional: swap provider without changing the brain
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Existing ICB authenticated coffee API: https://www.indiancoffeebeans.com/api/v1/coffees
ICB_API_BASE=https://www.indiancoffeebeans.com
ICB_API_KEY=

# Existing public Sanity project/dataset (validated from studio-icb)
SANITY_PROJECT_ID=otnc59kw
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
ICB_SITE_BASE=https://www.indiancoffeebeans.com

# Supabase ICB-v3: do NOT put your secret key in a browser or Git.
SUPABASE_URL=https://fnpsnzqedznsgzxjsowe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta developer app callback: https://YOUR_HOST/webhooks/meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_FACEBOOK_PAGE_TOKEN=
META_FACEBOOK_PAGE_ID=
# For Instagram Login, use Instagram user ID + Instagram access token.
# For Facebook Login, set META_INSTAGRAM_LOGIN_MODE=facebook and use Page token.
META_INSTAGRAM_LOGIN_MODE=instagram
META_INSTAGRAM_USER_ID=
META_INSTAGRAM_TOKEN=

# Keep the public bot in draft mode until you explicitly enable auto replies.
BOT_MODE=draft
ADMIN_TOKEN=
PORT=8080
WORKER_INTERVAL_MS=10000
WORKER_BATCH_SIZE=3
BOT_MAX_AGE_MINUTES=1380
